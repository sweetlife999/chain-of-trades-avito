# Скопировать в .env: cp .env.example .env
# Пароль ниже — для локальной разработки. Прод-значения в репозиторий не едут.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=chain_of_trades
POSTGRES_PORT=5432

# Для запуска с хоста (make migrate-up). Внутри compose адрес другой — см. docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/chain_of_trades?sslmode=disable

HTTP_ADDR=:8080

# Минимум 32 символа. Для реального окружения: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-1234567890

# false позволяет использовать cookie через локальный HTTP; в production должно быть true.
COOKIE_SECURE=false
