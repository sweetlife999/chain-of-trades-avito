# Скопировать в .env: cp .env.example .env
# Пароль ниже — для локальной разработки. Прод-значения в репозиторий не едут.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=chain_of_trades
POSTGRES_PORT=5432

# Для запуска с хоста (make migrate-up). Внутри compose адрес другой — см. docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/chain_of_trades?sslmode=disable

HTTP_ADDR=:8080

# Минимум 32 символа. Для реального окружения: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-1234567890

# false позволяет использовать cookie через локальный HTTP. Ставится в true вместе
# с появлением HTTPS, то есть когда в SITE_ADDRESS прописан домен.
COOKIE_SECURE=false

# Адрес, на котором Caddy отдаёт сайт. Пусто — HTTP на :80. Домен (exchange.example.com)
# — Caddy сам выпустит и продлит сертификат Let's Encrypt.
SITE_ADDRESS=

# Порты Caddy на хосте. 443 нужен только когда в SITE_ADDRESS домен.
WEB_PORT=80
WEB_TLS_PORT=443

# Локальная модель. Пусто — фичи поверх модели выключены, API поднимается как обычно;
# это единственная переменная, пустое значение которой не ошибка. Адрес указан для
# запуска с хоста (make run), внутри compose он переопределяется на http://ollama:11434.
OLLAMA_URL=http://localhost:11434
# Больше не влезает в память прод-сервера. Обоснование — docs/llm.md.
OLLAMA_MODEL=qwen2.5:0.5b
# Порт Ollama на хосте. Менять, только если своя Ollama уже занимает 11434.
OLLAMA_PORT=11434
