# Пусто — слушаем :80 по HTTP. Домен — Caddy сам выпустит Let's Encrypt.
{$SITE_ADDRESS::80}

encode gzip zstd

# Префикс срезается так же, как его срезает dev-прокси Vite: Go видит /items,
# /auth/login и /health без /api, поэтому маршруты и спека не переезжают.
handle_path /api/* {
	reverse_proxy api:8080
}

# Без среза префикса: /swagger редиректит на абсолютный /swagger/index.html,
# и под /api этот редирект ушёл бы в SPA-фоллбэк.
handle /swagger* {
	reverse_proxy api:8080
}

# Swagger UI шлёт запросы на абсолютные пути (@BasePath /), а не под /api, поэтому без
# этого блока каждый Execute со страницы /swagger попадал бы в SPA-фоллбэк ниже и получал
# index.html вместо JSON. Список префиксов — тот же, что регистрирует cmd/api/main.go.
#
# Часть этих путей (/admin, /exchanges, /items/:id) есть и в SPA-роутере, поэтому
# переходы по адресной строке и F5 из списка исключены: браузер шлёт на документ
# Sec-Fetch-Dest: document, а fetch со страницы /swagger — empty. Без исключения
# перезагрузка /admin уходила в API и отдавала 404 (маршрута GET /admin там нет).
@api {
	path /auth* /users* /items* /categories* /exchanges* /health /admin*
	not header Sec-Fetch-Dest document
}
handle @api {
	reverse_proxy api:8080
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
